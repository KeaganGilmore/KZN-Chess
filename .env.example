# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# NextAuth.js
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=https://kznchess.co.za

# Public site URL (used for share links, Open Graph, canonical metadata)
NEXT_PUBLIC_SITE_URL=https://kznchess.co.za

# Public contact email shown in the footer
NEXT_PUBLIC_CONTACT_EMAIL=info@kznchess.co.za

# Optional: Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key

# Optional: Google AdSense
# Publisher id (e.g. ca-pub-1234567890). Ads render only when this is set.
NEXT_PUBLIC_ADSENSE_PUB_ID=
# Real numeric ad-unit slot ids per placement (from your AdSense dashboard).
# Each placement renders only once its slot id is provided.
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_TOURNAMENT_LIST=
NEXT_PUBLIC_ADSENSE_SLOT_TOURNAMENT_DETAIL=
